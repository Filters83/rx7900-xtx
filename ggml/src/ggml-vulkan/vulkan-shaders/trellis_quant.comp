#version 450
#extension GL_EXT_control_flow_attributes : require

// Quantizes the rotated activations of a Trellis product to int8 for trellis_matvec_q8, with one scale per 16
// inputs (one tile column), absmax / 127. For tile column g and lane group q, reps holds the four inputs that the
// lanes with lane % 4 == q multiply (columns 2q, 2q + 1, 2q + 8 and 2q + 9 of the tile), each byte replicated four
// times, so that one dot4 with the four 6-bit bytes of a state gives the input times the byte sum. qmeta holds the
// sum of those four int8 values and the scale.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Activations { float x[]; };
layout(binding = 1) writeonly buffer Reps { uvec4 reps[]; };
layout(binding = 1) writeonly buffer Meta { uvec2 qmeta[]; };

layout(push_constant) uniform Parameters {
    uint k;
    uint n;
    uint batch;
    uint scale_offset;
} p;

void main() {
    const uint groups = p.k / 16;
    const uint g = gl_GlobalInvocationID.x;
    const uint token = gl_GlobalInvocationID.y;
    if (g >= groups) {
        return;
    }
    const uint base = token * p.k + 16 * g;
    float v[16];
    float amax = 0.0;
    [[unroll]] for (uint i = 0; i < 16; ++i) {
        v[i] = x[base + i];
        amax = max(amax, abs(v[i]));
    }
    const float d = amax / 127.0;
    const float id = amax > 0.0 ? 127.0 / amax : 0.0;
    int q[16];
    [[unroll]] for (uint i = 0; i < 16; ++i) {
        q[i] = clamp(int(round(v[i] * id)), -127, 127);
    }
    // the scale and sum entries follow the reps of all tokens, in uvec2 units
    const uint meta_base = p.batch * groups * 8;
    [[unroll]] for (uint lq = 0; lq < 4; ++lq) {
        const int c0 = q[2 * lq], c1 = q[2 * lq + 1], c2 = q[2 * lq + 8], c3 = q[2 * lq + 9];
        const uint index = (token * groups + g) * 4 + lq;
        reps[index] = uvec4(uint(c0 & 0xff) * 0x01010101u, uint(c1 & 0xff) * 0x01010101u,
                            uint(c2 & 0xff) * 0x01010101u, uint(c3 & 0xff) * 0x01010101u);
        qmeta[meta_base + index] = uvec2(uint(c0 + c1 + c2 + c3), floatBitsToUint(d));
    }
}
